{
  "name": "@note-systems/sdk",
  "version": "0.1.2",
  "description": "Typed client for the Note vault layer on Robinhood Chain: discover vaults, quote, deposit with attribution, track, exit, create.",
  "license": "MIT",
  "homepage": "https://note.systems/docs/build/vaults",
  "keywords": [
    "robinhood-chain",
    "erc-4626",
    "vault",
    "structured-products",
    "tokenised-stocks",
    "viem",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "abis": "node scripts/gen-abis.mjs",
    "check:abis": "node scripts/gen-abis.mjs --check",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.examples.json",
    "prepack": "npm run check:abis && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "viem": ">=2.21.0 <3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "viem": "2.56.3",
    "vitest": "^5.0.2"
  }
}
